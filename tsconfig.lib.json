// The ONE build. Both entry points, `ordpool-sdk` and `ordpool-sdk/core`, are
// emitted here from the same source set; `src/index.ts` and `src/core.ts` are
// the barrels that decide what each exposes.
//
// ESM, with explicit `.js` extensions written in the SOURCE imports. That is
// what makes the output resolvable by NODE and not only by a bundler: tsc does
// not rewrite specifiers, so an extensionless `./foo` stays `./foo` in the
// emit and Node rejects it (ERR_UNSUPPORTED_DIR_IMPORT / not-found).
//
// Why ESM rather than CommonJS, since a CommonJS consumer exists: Node 22.12+
// can `require()` an ESM package that has no top-level await, and this package
// has none. cat21-indexer's backend declares node >= 24, so its CommonJS
// NestJS app loads this fine. Verified, not assumed. The payoff is that
// bundlers tree-shake ESM properly, which CommonJS cost the three Angular
// frontends.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "es2022",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": [
      "dom",
      "esnext"
    ],
    "esModuleInterop": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
    "**/*.angular.spec.ts",
    "e2e"
  ]
}
