{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "es2022",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["dom", "esnext"],
    "esModuleInterop": true,
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "**/*.spec.ts", "e2e"]
}
