// CommonJS output for the `/core` entry point.
//
// Both entry points compile the SAME source set: this file differs from
// tsconfig.lib.json only in module format and outDir. `src/core.ts` is the
// barrel that decides what `/core` actually exposes, so adding a helper is
// one step (re-export it there) rather than two.
//
// Why a second format exists at all: it is NOT about Angular, and never was
// about anything the SDK imports. cat21-indexer's backend is a CommonJS
// NestJS app that requires validateCat21BuyOfferPsbt and MAX_ASK_SATS from
// this entry on the offer path, and a CommonJS app cannot require an ESM
// package. The ESM dist/ additionally uses directory imports, which only a
// bundler resolves and Node rejects outright.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist-core",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2022",
    "lib": [
      "dom",
      "esnext"
    ],
    "esModuleInterop": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "**/*.angular.spec.ts",
    "**/*.spec.ts",
    "node_modules",
    "src/**/*.spec.ts"
  ]
}
