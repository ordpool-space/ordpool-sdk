{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist-core",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "es2022",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["dom", "esnext"],
    "esModuleInterop": true
  },
  "include": [
    "src/core.ts",
    "src/cat21-protocol/index.ts",
    "src/cat21-protocol/cat21-postage.ts",
    "src/cat21-protocol/cat21-lock-time.ts",
    "src/cat21-protocol/cat21-sequence.ts",
    "src/cat21-script/index.ts",
    "src/cat21-script/address-format.ts",
    "src/cat21-script/build-input-script.ts",
    "src/cat21-script/per-wallet-scripts.ts",
    "src/network.ts",
    "src/wallet/wallet.service.types.ts",
    "src/wallet/wallet-logos.ts",
    "src/cat21-mint/cat21.service.helper.ts",
    "src/cat21-mint/cat21.service.types.ts",
    "src/cat21-mint/cat21-mint.helper.ts",
    "src/cat21-mint/cat21-mint-input-adapter.ts",
    "src/cat21-fee/fee-simulation.helper.ts",
    "src/cat21-fee/coin-selection.helper.ts",
    "src/cat21-fee/dummy-keypair.ts",
    "src/cat21-transfer/cat21-transfer.helper.ts",
    "src/cat21-transfer/cat21-transfer.types.ts",
    "src/cat21-transfer/cat21-transfer-input-adapter.ts",
    "src/cat21-offer/cat21-offer.helper.ts",
    "src/cat21-offer/cat21-offer.types.ts",
    "src/cat21-offer/cat21-offer-input-adapter.ts",
    "src/cat21-broadcast/broadcast.helper.ts",
    "src/cat21-broadcast/slipstream.helper.ts",
    "src/agent-mode/agent-policy.helper.ts",
    "src/agent-mode/agent-policy.types.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
    "**/*.angular.spec.ts"
  ]
}
