/node_modules/
/dist
/dist-commonjs

# dist/ (both entry points) is NOT checked
# in — it is a plain `tsc` build regenerated by the `prepare` script at
# consumer-install time (`npm run build:main`). Consumers MUST have
# `ignore-scripts=false` in their .npmrc — otherwise npm skips prepare
# and the output ends up missing.
#
# dist-e2e/ (the /e2e entry) IS checked in: its barrel imports the
# Playwright onboarding helpers, and @playwright/test is an OPTIONAL
# peer dep, so building it in prepare would fail for consumers without
# Playwright. Shipping the compiled bytes lets them import
# `ordpool-sdk/e2e` without that dev dep. Rebuild + commit it when its
# source changes (CI diffs it).
#
# See the SDK CLAUDE.md "Shipped artifacts" section.

# Playwright + Xverse: fetched fresh in CI, never committed
/e2e/extensions/
/e2e/playwright/fixtures/sdk-harness.js
/playwright-report/
/test-results/

# System Files
.DS_Store
Thumbs.db

# IDE files
.vscode/settings.json

# Jest coverage output (node + browser configs). Regenerated by every
# `--coverage` run; four files were briefly tracked (8c08011) and dirtied
# the tree on each run.
coverage/
coverage-browser/

# Xverse onboarding seed cache. Outside test-results on purpose: Playwright
# clears its outputDir at the start of every run.
/e2e/playwright/.xverse-seed/
