/node_modules/
/dist-commonjs
/dist-core

# dist/ (Angular ng-packagr fesm2022 bundle) IS checked in — the
# ng-packagr tsc bug in a parent's node_modules blocks running
# `build:angular` from the prepare hook, so Angular consumers
# (ordpool/frontend, cat21-indexer/frontend) rely on the shipped
# tarball bytes.
#
# dist-core/ is NOT checked in. It's regenerated by the `prepare`
# script at consumer-install time via `npm run build:core` (plain
# tsc; unaffected by the ng-packagr bug). Consumers that import
# from `ordpool-sdk/core` MUST have `ignore-scripts=false` in
# their .npmrc — otherwise npm's global posture skips prepare and
# `dist-core/` ends up missing.
#
# See the SDK CLAUDE.md "Shipped artifacts" section.

# Playwright + Xverse: fetched fresh in CI, never committed
/e2e/extensions/
/e2e/playwright/fixtures/sdk-harness.js
/playwright-report/
/test-results/

