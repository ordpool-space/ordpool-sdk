{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist-e2e",
    "rootDir": "e2e",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2022",
    "lib": ["dom", "esnext"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    // The e2e helpers reach SDK code only through a built subpath, never
    // through src/ (outside this rootDir). Types come from the main build's
    // declarations; at run time Node resolves the same specifier through the
    // package's own `exports` map (its `require` condition, dist-cjs). That
    // self-reference needs dist-e2e/ inside the package's scope, so the build
    // writes no package.json there: the root one, without a `type`, already
    // makes these files CommonJS.
    "paths": {
      "ordpool-sdk/testing": ["./dist/testing.d.ts"],
      "ordpool-sdk/network": ["./dist/network.d.ts"]
    }
  },
  "include": ["e2e/index.ts", "e2e/globals.d.ts"],
  // Specs are excluded because they import from src/, which is outside this
  // config's rootDir. The consequence is a trap: `npm run build:e2e` going
  // green says NOTHING about whether a spec typechecks. ts-jest checks them at
  // run time, so a type error costs a full regtest lane to discover.
  //
  // To typecheck a spec without the stack up (ts-jest compiles before it
  // connects to anything):
  //   npx jest --config e2e/jest.config.regtest.js -t "__none__" --testPathPatterns=<spec>
  "exclude": ["node_modules", "**/*.spec.ts", "**/*.angular.spec.ts"]
}
