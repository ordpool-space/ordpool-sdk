{
  "name": "ordpool-sdk",
  "version": "0.1.0",
  "description": "Higher-level Bitcoin / Ordinals SDK for ordpool \u2014 REST wrappers, calendar clients, signing helpers, and other domain code that doesn't fit in ordpool-parser. Framework-agnostic; runs in the browser and in plain Node.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ordpool-space/ordpool-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/ordpool-space/ordpool-sdk/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist-core/core.d.ts",
      "default": "./dist-core/core.js"
    },
    "./e2e": {
      "types": "./dist-e2e/index.d.ts",
      "default": "./dist-e2e/index.js"
    }
  },
  "files": [
    "dist",
    "dist-core",
    "dist-e2e",
    "src",
    "e2e",
    "wasm",
    "*.js",
    "*.json"
  ],
  "scripts": {
    "clean": "rimraf dist dist-core dist-e2e",
    "build": "npm run build:main && npm run build:core && npm run build:e2e",
    "build:main": "tsc -p tsconfig.lib.json && node -e \"require('fs').writeFileSync('dist/package.json', JSON.stringify({type:'module'},null,2))\"",
    "build:core": "tsc -p tsconfig.core.json && node -e \"require('fs').writeFileSync('dist-core/package.json', JSON.stringify({type:'commonjs'},null,2))\"",
    "build:e2e": "tsc -p tsconfig.e2e.json && node -e \"require('fs').writeFileSync('dist-e2e/package.json', JSON.stringify({type:'commonjs'},null,2))\"",
    "prepare": "npm run build:main && npm run build:core",
    "start": "npm run test",
    "test": "npm run test:node && npm run test:browser",
    "test:node": "jest --config jest.config.node.js",
    "test:node:watch": "jest --config jest.config.node.js --watch ",
    "test:browser": "jest --config jest.config.browser.js",
    "test:browser:watch": "jest --config jest.config.browser.js --watch ",
    "test:e2e:regtest:up": "docker compose -f e2e/docker-compose.regtest.yml up -d",
    "test:e2e:regtest:down": "docker compose -f e2e/docker-compose.regtest.yml down -v",
    "test:e2e:regtest": "jest --config e2e/jest.config.regtest.js",
    "test:e2e:playwright": "playwright test --config=e2e/playwright/playwright.config.ts",
    "e2e:harness:build": "node e2e/playwright/build-harness.js",
    "e2e:harness:serve": "node e2e/playwright/fixtures-server.js",
    "gen:brotli-wasm": "node scripts/gen-brotli-wasm.mjs",
    "create-link": "npm run build && cd dist && npm link"
  },
  "keywords": [
    "bitcoin",
    "ordinals",
    "ordpool",
    "sdk",
    "cat21",
    "wallet",
    "signing"
  ],
  "author": "HAUS HOPPE",
  "license": "MIT",
  "dependencies": {
    "@noble/hashes": ">=1",
    "@scure/base": ">=1",
    "@scure/bip32": "1.4.x"
  },
  "peerDependencies": {
    "@noble/curves": ">=1",
    "@playwright/test": ">=1.50",
    "@scure/btc-signer": "1.2.x",
    "rxjs": ">=7",
    "sats-connect": ">=4"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-typescript": "^7.28.5",
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.4.0",
    "@playwright/test": "^1.50.0",
    "@scure/base": "^1.1.5",
    "@scure/bip32": "1.4.0",
    "@scure/btc-signer": "1.2.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.9",
    "babel-jest": "^30.4.1",
    "brotli-wasm": "3.0.1",
    "esbuild": "^0.24.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "ordpool-parser": "github:ordpool-space/ordpool-parser#f090777a95ac3b9ca46cca1eac194b003f657ad6",
    "rimraf": "^5.0.7",
    "rxjs": "^7.8.1",
    "sats-connect": "^4.2.1",
    "ts-jest": "29.4",
    "typescript": "^5.5.2"
  }
}
