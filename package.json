{
  "name": "ordpool-sdk",
  "version": "0.1.0",
  "description": "Higher-level Bitcoin / Ordinals SDK for ordpool — REST wrappers, calendar clients, signing helpers, and other domain code that doesn't fit in ordpool-parser. Angular library; built with ng-packagr.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ordpool-space/ordpool-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/ordpool-space/ordpool-sdk/issues"
  },
  "main": "./dist/fesm2022/ordpool-sdk.mjs",
  "module": "./dist/fesm2022/ordpool-sdk.mjs",
  "typings": "./dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "build": "ng-packagr -p ng-package.json",
    "start": "npm run test",
    "test": "npm run test:node && npm run test:browser",
    "test:node": "jest --config jest.config.node.js",
    "test:node:watch": "jest --config jest.config.node.js --watch ",
    "test:browser": "jest --config jest.config.browser.js",
    "test:browser:watch": "jest --config jest.config.browser.js --watch ",
    "prepare": "npm run build",
    "create-link": "npm run build && cd dist && npm link"
  },
  "keywords": [
    "bitcoin",
    "ordinals",
    "ordpool",
    "sdk",
    "cat21",
    "wallet",
    "signing"
  ],
  "author": "HAUS HOPPE",
  "license": "MIT",
  "peerDependencies": {
    "@angular/common": ">=20",
    "@angular/core": ">=20",
    "@angular/router": ">=20",
    "@noble/curves": ">=1",
    "@scure/base": ">=1",
    "@scure/btc-signer": "1.2.x",
    "rxjs": ">=7",
    "sats-connect": ">=1"
  },
  "devDependencies": {
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.3.21",
    "@angular/compiler-cli": "^20.3.21",
    "@angular/core": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.4.0",
    "@scure/base": "^1.1.5",
    "@scure/btc-signer": "1.2.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ng-packagr": "^20.3.2",
    "rimraf": "^5.0.7",
    "rxjs": "^7.8.1",
    "sats-connect": "^1.1.2",
    "ts-jest": "^29.1.5",
    "typescript": "^5.5.2"
  },
  "files": [
    "dist",
    "src",
    "*.js",
    "*.json"
  ]
}
