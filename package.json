{
  "name": "ordpool-sdk",
  "version": "0.1.0",
  "description": "Higher-level Bitcoin / Ordinals SDK for ordpool — REST wrappers, calendar clients, signing helpers, and other domain code that doesn't fit in ordpool-parser. Angular library; built with ng-packagr.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ordpool-space/ordpool-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/ordpool-space/ordpool-sdk/issues"
  },
  "main": "./dist/fesm2022/ordpool-sdk.mjs",
  "module": "./dist/fesm2022/ordpool-sdk.mjs",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/fesm2022/ordpool-sdk.mjs"
    },
    "./core": {
      "types": "./dist-core/core.d.ts",
      "default": "./dist-core/core.js"
    }
  },
  "files": [
    "dist",
    "src",
    "e2e",
    "*.js",
    "*.json"
  ],
  "scripts": {
    "clean": "rimraf dist dist-core",
    "build": "npm run build:angular && npm run build:core",
    "build:angular": "ng-packagr -p ng-package.json",
    "build:core": "tsc -p tsconfig.core.json && node -e \"require('fs').writeFileSync('dist-core/package.json', JSON.stringify({type:'commonjs'},null,2))\"",
    "prepare": "npm run build:core",
    "start": "npm run test",
    "test": "npm run test:node && npm run test:browser",
    "test:node": "jest --config jest.config.node.js",
    "test:node:watch": "jest --config jest.config.node.js --watch ",
    "test:browser": "jest --config jest.config.browser.js",
    "test:browser:watch": "jest --config jest.config.browser.js --watch ",
    "test:e2e:regtest:up": "docker compose -f e2e/docker-compose.regtest.yml up -d",
    "test:e2e:regtest:down": "docker compose -f e2e/docker-compose.regtest.yml down -v",
    "test:e2e:regtest": "jest --config e2e/jest.config.regtest.js",
    "test:e2e:playwright": "playwright test --config=e2e/playwright/playwright.config.ts",
    "e2e:harness:build": "node e2e/playwright/build-harness.js",
    "e2e:harness:serve": "node e2e/playwright/fixtures-server.js",
    "create-link": "npm run build && cd dist && npm link"
  },
  "keywords": [
    "bitcoin",
    "ordinals",
    "ordpool",
    "sdk",
    "cat21",
    "wallet",
    "signing"
  ],
  "author": "HAUS HOPPE",
  "license": "MIT",
  "peerDependencies": {
    "@angular/common": ">=20",
    "@angular/core": ">=20",
    "@noble/curves": ">=1",
    "@scure/base": ">=1",
    "@scure/btc-signer": "1.2.x",
    "rxjs": ">=7",
    "sats-connect": ">=4"
  },
  "devDependencies": {
    "@angular/common": "^20.3.25",
    "@angular/compiler": "^20.3.25",
    "@angular/compiler-cli": "^20.3.25",
    "@angular/core": "^20.3.25",
    "@angular/platform-browser": "^20.3.25",
    "@angular/platform-browser-dynamic": "^20.3.25",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-typescript": "^7.28.5",
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.4.0",
    "@playwright/test": "^1.50.0",
    "@scure/base": "^1.1.5",
    "@scure/btc-signer": "1.2.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.9",
    "babel-jest": "^30.4.1",
    "esbuild": "^0.24.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-preset-angular": "^16.1.5",
    "ng-packagr": "^20.3.2",
    "ordpool-parser": "github:ordpool-space/ordpool-parser#f090777",
    "rimraf": "^5.0.7",
    "rxjs": "^7.8.1",
    "sats-connect": "^4.2.1",
    "ts-jest": "29.4",
    "typescript": "^5.5.2"
  }
}
