{
  // The harness is bundled by esbuild (`npm run e2e:harness:build`), which
  // strips types without checking them, and it sits outside tsconfig.e2e's
  // rootDir because it imports from src/. Without this config nothing
  // typechecks it, and a type error only surfaces as a runtime failure in a
  // full Playwright lane.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["dom", "esnext"],
    "skipLibCheck": true,
    "types": []
  },
  "include": ["fixtures/sdk-harness.ts"]
}
