# The source revisions every e2e stack in the ordpool family builds: our
# electrs fork, cat21-ord, Cat21 Wallet and the ordpool backend (the
# `ordpool-backend` profile of docker-compose.regtest.yml, built from
# ORDPOOL_SRC). Full 40-character shas, never a
# branch name, so a lane builds exactly what this SDK commit was proven with.
#
# Format: one KEY=sha per line, nothing else besides comments. Readable by a
# shell (`set -a; . build-pins.env; set +a`), by GitHub Actions
# (`grep -E '^[A-Z0-9_]+=' build-pins.env >> "$GITHUB_ENV"`), and by a
# KEY=VALUE parser.
#
# Reading it from a consumer: the file ships in the package, so a consumer reads
# the copy that matches its `package-lock.json`, never a second checkout:
#
#   - name: Read the SDK's build pins
#     run: grep -E '^[A-Z0-9_]+=' node_modules/ordpool-sdk/e2e/build-pins.env >> "$GITHUB_ENV"
#   - uses: actions/checkout@v5
#     with:
#       repository: ordpool-space/ordpool-electrs
#       ref: ${{ env.ORDPOOL_ELECTRS_SHA }}
#       path: _ordpool-electrs-src
#
# then point ELECTRS_SRC / CAT21_ORD_SRC / ORDPOOL_SRC at those checkouts. Cat21 Wallet is
# built from source at CAT21_WALLET_SHA, on the Node its own .nvmrc names, and
# staged into the SDK checkout's e2e/extensions/cat21wallet by the composite
# action in that checkout:
#
#   - uses: ./sdk/.github/actions/build-cat21-wallet
#     with:
#       wallet-sha: ${{ env.CAT21_WALLET_SHA }}
#       node-version: '26'
#
# regtest-bootstrap.sh and consumer-environment-bootstrap.sh compare the
# checkouts they build from with these shas: a mismatch fails under CI and is
# reported locally.
#
# Moving a pin: build the new sha, run the lanes that boot it, change the line
# here in the same commit as anything that depends on it.

# ordpool-space/ordpool-electrs, branch ordpool
ORDPOOL_ELECTRS_SHA=a3e638ed9d88525c5dbf8d4404a57e0a8932eac5
# ordpool-space/cat21-ord, branch index-cat21
CAT21_ORD_SHA=2d21a8379aab3c2487d1cb4645d1643062c82409
# ordpool-space/cat21-wallet, branch main
CAT21_WALLET_SHA=ec438544e74b22c9eea085ab8f94be37df959d47
# ordpool-space/ordpool, branch main: the ordpool-backend service. ordpool's own
# lanes build the backend from the commit under test instead.
ORDPOOL_SHA=8ae2df4d0231f39b5c52de971128d2600d93ece5
